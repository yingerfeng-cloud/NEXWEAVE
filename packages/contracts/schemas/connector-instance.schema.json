{
  "$defs": {
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "HIGHLY_RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowlist": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Allowlist",
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification",
      "default": "INTERNAL"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "config_checksum": {
      "title": "Config Checksum",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid7",
      "title": "Created By",
      "type": "string"
    },
    "credential_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Ref"
    },
    "definition_id": {
      "format": "uuid7",
      "title": "Definition Id",
      "type": "string"
    },
    "field_mapping": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Field Mapping",
      "type": "object"
    },
    "id": {
      "format": "uuid7",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "FILESYSTEM",
        "S3",
        "WEB_REST",
        "GIT"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "space_id": {
      "format": "uuid7",
      "title": "Space Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "FAILED",
        "REVOKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid7",
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "updated_by": {
      "format": "uuid7",
      "title": "Updated By",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "watermark": {
      "additionalProperties": true,
      "title": "Watermark",
      "type": "object"
    }
  },
  "required": [
    "definition_id",
    "name",
    "kind",
    "allowlist",
    "id",
    "tenant_id",
    "space_id",
    "status",
    "config_checksum",
    "watermark",
    "version",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "title": "ConnectorInstanceResponse",
  "type": "object"
}
