          "additionalProperties": true,
          "title": "Output Summary",
          "type": "object"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "step_key": {
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "step_key",
        "input_checksum",
        "status",
        "attempt",
