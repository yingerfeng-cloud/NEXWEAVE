          "type": "integer"
        },
        "parse_job_id": {
          "format": "uuid7",
          "title": "Parse Job Id",
          "type": "string"
        },
        "source_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Checksum",
          "type": "string"
        },
        "source_version_id": {
          "format": "uuid7",
          "title": "Source Version Id",
          "type": "string"
        }
      },
      "required": [
        "source_version_id",
        "source_checksum",
        "parse_job_id",
        "input_order"
      ],
      "title": "CompileSourceRef",
      "type": "object"
    },
