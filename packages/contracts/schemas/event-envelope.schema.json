{
  "$defs": {
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "HIGHLY_RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "format": "uuid7",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_version": {
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid7",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "correlation_id": {
      "format": "uuid7",
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "datacontenttype": {
      "default": "application/json",
      "title": "Datacontenttype",
      "type": "string"
    },
    "dataschema": {
      "title": "Dataschema",
      "type": "string"
    },
    "id": {
      "format": "uuid7",
      "title": "Id",
      "type": "string"
    },
    "source": {
      "pattern": "^/nexweave/[a-z0-9/_-]+$",
      "title": "Source",
      "type": "string"
    },
    "space_id": {
      "anyOf": [
        {
          "format": "uuid7",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Space Id"
    },
    "specversion": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Specversion",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid7",
      "title": "Tenant Id",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "type": {
      "pattern": "^io\\.nexweave\\.[a-z0-9_.]+\\.v[1-9][0-9]*$",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "subject",
    "time",
    "dataschema",
    "tenant_id",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "classification",
    "data"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
