{
  "$defs": {
    "DomainPackRevocationEntry": {
      "additionalProperties": false,
      "properties": {
        "contentChecksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentchecksum"
        },
        "keyId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyid"
        },
        "packId": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{1,62}-pack$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packid"
        },
        "reasonCode": {
          "pattern": "^[A-Z0-9_]{1,128}$",
          "title": "Reasoncode",
          "type": "string"
        },
        "revokedAt": {
          "format": "date-time",
          "title": "Revokedat",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "reasonCode",
        "revokedAt"
      ],
      "title": "DomainPackRevocationEntry",
      "type": "object"
    },
    "DomainPackSecurity": {
      "additionalProperties": false,
      "properties": {
        "executableContent": {
          "const": false,
          "title": "Executablecontent",
          "type": "boolean"
        },
        "signature": {
          "$ref": "#/$defs/DomainPackSignature"
        }
      },
      "required": [
        "executableContent",
        "signature"
      ],
      "title": "DomainPackSecurity",
      "type": "object"
    },
    "DomainPackSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "keyId": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Keyid",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "title": "DomainPackSignature",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "nexweave.io/pack-revocation/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "canonicalizationAlgorithm": {
      "const": "RFC8785-JCS/1",
      "title": "Canonicalizationalgorithm",
      "type": "string"
    },
    "kind": {
      "const": "NexweavePackRevocationList",
      "title": "Kind",
      "type": "string"
    },
    "revoked": {
      "items": {
        "$ref": "#/$defs/DomainPackRevocationEntry"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Revoked",
      "type": "array"
    },
    "security": {
      "$ref": "#/$defs/DomainPackSecurity"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "canonicalizationAlgorithm",
    "revoked",
    "security"
  ],
  "title": "DomainPackRevocationListV1Alpha1",
  "type": "object"
}
